# VoiceTel API credentials for integration tests.
# Copy this file to .env and fill in the values, then run:
#   dotnet test --filter "Category=Integration"
#
# Get credentials at https://voicetel.com/docs/api/v2.2/credentials/
VOICETEL_USERNAME=1000000001
VOICETEL_PASSWORD=replace-me
# Optional: override the API endpoint (defaults to https://api.voicetel.com).
VOICETEL_BASE_URL=https://api.voicetel.com
